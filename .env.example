# ============================================================
# Variables de entorno — Versus Legal Marcas
# Copia este archivo como .env.local para desarrollo.
# En Vercel se configuran en: Project > Settings > Environment Variables
# ⚠ NUNCA subas .env.local ni secretos reales a GitHub.
# ============================================================

# --- Base de datos (libSQL / Turso) ---
# Local (desarrollo): archivo SQLite
DATABASE_URL="file:./dev.db"
# Producción (Vercel): URL remota de Turso, ej: libsql://tu-db.turso.io
# DATABASE_URL="libsql://xxxxx.turso.io"
# Token de la BD remota (solo producción)
DATABASE_AUTH_TOKEN=""

# --- Seguridad de sesión ---
# Cadena larga y aleatoria. Genera una con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-secreta"

# --- Credenciales del administrador inicial (se crea en el primer arranque) ---
ADMIN_USER="ADMIN"
ADMIN_PASSWORD="123456"

# --- (Opcional / futuro) Integración autorizada con SIPI de la SIC ---
# NO se usa para automatizar el login (va contra los términos del portal).
# Reservado para una integración oficial futura. Déjalo vacío por ahora.
# SIC_USERNAME=""
# SIC_PASSWORD=""
