# ============================================================
# Variables de entorno — Versus Legal Marcas (Firebase Firestore)
# Copia este archivo como .env.local para desarrollo.
# En Vercel se configuran en: Project > Settings > Environment Variables
# ⚠ NUNCA subas .env.local ni secretos reales a GitHub.
# ============================================================

# --- Firebase (Firestore) ---
# Se obtienen del archivo JSON de la cuenta de servicio:
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
FIREBASE_PROJECT_ID="tu-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@tu-project-id.iam.gserviceaccount.com"
# Copia el valor "private_key" tal cual (entre comillas). Mantiene los \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Seguridad de sesión ---
# Cadena larga y aleatoria. Genera una con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-secreta"

# --- Administrador inicial (se crea en el primer arranque si no hay usuarios) ---
ADMIN_USER="ADMIN"
ADMIN_PASSWORD="123456"

# --- (Solo desarrollo con emulador de Firestore, opcional) ---
# FIRESTORE_EMULATOR_HOST="localhost:8080"
